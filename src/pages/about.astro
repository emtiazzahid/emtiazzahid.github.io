---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts.js';

const skills = [
  { label: 'Core languages', items: 'PHP · JavaScript · TypeScript · C' },
  { label: 'Frameworks & runtimes', items: 'Laravel · Vue.js · React · Node.js' },
  { label: 'Platforms', items: 'WordPress · WooCommerce · SiteVision' },
  { label: 'Data & infrastructure', items: 'MySQL · SQL Server · Redis · AWS · Google Cloud' },
  { label: 'Practice', items: 'Git · Jira · Composer · npm · Socket.io · Pusher' },
];

const description =
  'Emtiaz Zahid — software engineer in Dhaka, Bangladesh. Laravel, Vue, React, and WordPress since 2016.';
---

<BaseLayout title={`About — ${SITE.title}`} description={description}>
  <section class="section">
    <h1 class="page-title">About</h1>

    <div class="bio">
      <p>
        I'm Emtiaz Zahid, a software engineer in Dhaka, Bangladesh. Since 2016 I've shipped software
        for garment factories, clinics, laundries, and email platforms — mostly with Laravel, Vue,
        and WordPress.
      </p>
      <p>
        Today I work at <a class="link-plain" href="https://getonnet.no" target="_blank" rel="noopener"
          >GetOnNet</a
        >, split between PHP and JavaScript — maintaining Laravel APIs and building WordPress sites,
        plugins, and themes on one side; React, TypeScript, and AI features on the other, including
        SiteVision add-ons. All of it for clients in Norway. Before that I spent two years at <a
          class="link-plain"
          href="https://wedevs.com"
          target="_blank"
          rel="noopener">weDevs</a
        > on weMail, a WordPress email-marketing platform.
      </p>
      <p>
        I hold a B.Sc. in Computer Science from BUBT, and I care about boring, reliable systems — and
        about writing down what building them teaches me.
      </p>
    </div>

    <div class="skills">
      <h2 class="eyebrow ruled">Skills &amp; tools</h2>
      <div class="skills__grid">
        {
          skills.map((group) => (
            <div>
              <div class="skills__label">{group.label}</div>
              <div class="skills__items">{group.items}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
